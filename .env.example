# --- AI provider (summaries, deep dives, Q&A, digests) ---
# claude | openai | auto (auto = OpenAI when only OPENAI_API_KEY is set, otherwise Claude)
FRONTLINE_LLM=auto
# OpenAI (ChatGPT API): key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Claude ---
# Any credential the Anthropic SDK understands works (ANTHROPIC_API_KEY, or `ant auth login`).
# With no credentials, Frontline still sweeps and shows cards using a keyword/abstract-based fallback.
ANTHROPIC_API_KEY=
FRONTLINE_MODEL=claude-opus-5-5
# Effort for per-paper card summaries (low keeps sweeps fast & cheap) and for on-demand deep dives
FRONTLINE_SUMMARY_EFFORT=low
FRONTLINE_DEEP_DIVE_EFFORT=medium

# --- Sweep behaviour ---
FRONTLINE_MAX_PAPERS_PER_TOPIC=40
FRONTLINE_CONCURRENCY=4
# Followed researchers: how far back their lab feed goes, and the per-sweep summary cap
FRONTLINE_RESEARCHER_LOOKBACK_DAYS=180
FRONTLINE_MAX_PAPERS_PER_RESEARCHER=60
# Run a sweep automatically every N hours while the server is up (0 = only when you press the button)
FRONTLINE_AUTO_SWEEP_HOURS=0

# --- Paper library ---
# Folder holding your PDFs (e.g. inside Google Drive for desktop). You can also pick it in the app.
FRONTLINE_LIBRARY_DIR=

# --- Paper sources (all free; keys just raise rate limits) ---
SEMANTIC_SCHOLAR_API_KEY=
# OpenAlex "polite pool": put your email here for faster, more reliable responses
OPENALEX_MAILTO=

# --- Notifications (all optional) ---
# Phone/desktop push via https://ntfy.sh — install the ntfy app and subscribe to this topic name
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Email digest
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO=
# Used for links inside notifications
PUBLIC_URL=http://localhost:8000
